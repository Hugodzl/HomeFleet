{
  "name": "@homefleet/daemon",
  "version": "0.8.0",
  "description": "homefleetd — the HomeFleet per-machine daemon (MCP front, node service, discovery, dispatch)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "homefleet": "./dist/bin/homefleet.js",
    "homefleet-mcp-stdio": "./dist/bin/homefleet-mcp-stdio.js",
    "homefleetd": "./dist/bin/homefleetd.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@homefleet/executors": "workspace:*",
    "@homefleet/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@peculiar/asn1-schema": "^3.1.0",
    "@peculiar/x509": "^3.1.0",
    "asn1js": "^4.1.0",
    "bonjour-service": "^1.4.4",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  }
}
