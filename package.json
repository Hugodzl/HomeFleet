{
  "name": "homefleet-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pack:release": "tsx scripts/pack-release.ts",
    "sign:release": "node scripts/sign-release.mjs",
    "verify:release": "tsx scripts/verify-release.ts",
    "release:keygen": "tsx scripts/release-keygen.ts",
    "check:docs": "tsx scripts/check-docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
